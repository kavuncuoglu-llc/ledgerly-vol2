APP_NAME=Ledgerly
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# Postgres 16 + pgvector from compose.yaml. The tests use ledgerly_testing in the same container.
DB_CONNECTION=pgsql
DB_HOST=127.0.0.1
DB_PORT=5432
DB_DATABASE=ledgerly
DB_USERNAME=ledgerly
DB_PASSWORD=secret

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=reverb
FILESYSTEM_DISK=local
QUEUE_CONNECTION=redis

CACHE_STORE=database

# Redis from compose.yaml: the queue (Horizon) and the broadcast fan-out since Chapter 18. predis needs no PHP extension; set phpredis if you have it.
REDIS_CLIENT=predis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_FROM_ADDRESS="support@ledgerly.test"
MAIL_FROM_NAME="${APP_NAME}"

# The model server. Defaults point at Ollama on this machine (Chapter 0, Figure 0-6).
# From Chapter 22 the chat model is ledgerly-support: llama3.1:8b-instruct-q4_K_M with num_ctx 8192 baked in. Build it once:
#   ollama create ledgerly-support -f ops/ollama/Modelfile.ledgerly-support        (or `--profile ollama` in Compose does it for you)
# Until you have, AI_MODEL=llama3.1:8b works; `php artisan ai:doctor` says which of them truncates your prompts.
AI_BASE_URL=http://localhost:11434/v1
AI_API_KEY=ollama
AI_MODEL=ledgerly-support
# The app runs on your machine, so localhost reaches native Ollama (macOS, Windows, Linux service) and the Compose profile alike (it publishes 127.0.0.1 only).
# Only a container needs http://host.docker.internal:11434/v1 to reach a native Ollama on a Mac (ops/compose/macos.override.yml).
OLLAMA_URL=http://localhost:11434/v1

# Vision (Chapter 7): any vision-capable model. moondream is the lighter choice.
AI_VISION_MODEL=llama3.2-vision:11b

# Embeddings (Chapter 6). The vector column in help_chunks is 768 wide; change the model and you re-embed everything.
AI_EMBED_MODEL=nomic-embed-text
AI_EMBED_DIMENSIONS=768

# The date Ledgerly treats as "today" when it works out days overdue. The seed data is
# anchored to it so every reader sees the same numbers. Leave empty to use the real clock.
LEDGERLY_AS_OF=2026-04-20

# Token counting and the context budget (Chapter 2). ratio | tiktoken | server
AI_TOKEN_COUNTER=ratio
AI_CONTEXT_WINDOW=8192

# How structured output is requested (Chapter 10). schema = json_schema, json = json_object, ask = prompt only
AI_STRUCTURED_LEVEL=schema

# How records are written for the model (Chapter 12). toon | tsv | markdown | json
AI_ENCODING_DEFAULT=toon

# Chapter 14: answer repeated how-to questions from pgvector without calling the model; explicit cache markers for providers that need them (null = by provider)
AI_SEMANTIC_CACHE=true
AI_CACHE_BREAKPOINTS=

# Chapter 15: retrieval over the help center. hybrid | vector | keyword; LEDGERLY_HELP_VERSION pins the help_version (empty = help:ingest stamps a hash of the articles)
AI_RETRIEVAL_MODE=hybrid
LEDGERLY_HELP_VERSION=

# Chapter 16: reranking and PDF parsing in the Python sidecar (docker compose --profile sidecar up -d), query rewriting, parent-child chunks.
# With the sidecar stopped, retrieval falls back to the hybrid order and logs a warning.
AI_RERANKER=sidecar
SIDECAR_URL=http://localhost:8008
SIDECAR_PORT=8008
AI_QUERY_REWRITE=rewrite
AI_RETRIEVAL_STRATEGY=heading
AI_RETRIEVAL_CONTEXT_HEADERS=path
AI_RETRIEVAL_CONTEXT_MODEL=
LEDGERLY_DOCS_PATH=

# Chapter 17: classify the first question of a conversation (three votes) to choose tools and the retrieval area before the main call
AI_ROUTER=true

# Chapter 11: the user id that `php artisan mcp:start ledgerly` (stdio, no login) acts as. HTTP clients use a Sanctum token instead.
LEDGERLY_MCP_USER=

# Connection settings read by config/ai.php (Chapter 3 uses them for ai:timings; Chapter 8 for the client)
AI_PROVIDER=ollama
AI_CONNECT_TIMEOUT=2
AI_TIMEOUT=120

# Chapter 18: inference runs on the `ai` queue (Horizon) and streams to the browser through Reverb. Start them next to `php artisan serve`:
#   php artisan horizon        php artisan reverb:start
# AI_CONCURRENCY = how many model calls run at once. Match your model server (Ollama laptop: 1 to 2; Appendix G for GPUs).
AI_CONCURRENCY=2
REVERB_APP_ID=ledgerly-local
REVERB_APP_KEY=ledgerly-local-key
REVERB_APP_SECRET=ledgerly-local-secret-change-me
REVERB_HOST=localhost
REVERB_PORT=8080
REVERB_SCHEME=http
REVERB_SERVER_HOST=0.0.0.0
REVERB_SERVER_PORT=8080
REVERB_ALLOWED_ORIGINS=localhost,127.0.0.1

# Chapter 19: named providers (config/ai.php). `local` is the model above; `frontier` is a second, hosted, OpenAI-compatible endpoint for the hard cases.
# It is UNSET by default: with no FRONTIER_* variables nothing is ever sent to a hosted model, and `php artisan ai:providers` says so.
# Setting it means customer text can leave your network for the tickets the features map escalates (urgent bugs, investigations that reach no conclusion). Read your provider's data terms first.
AI_DEFAULT_PROVIDER=local
FRONTIER_DRIVER=openai-compatible
FRONTIER_URL=
FRONTIER_KEY=
FRONTIER_MODEL=
# $ per 1M tokens, from your provider's price page; 0 until you set them, so model_calls.cost_micros is honest about not knowing
FRONTIER_RATE_IN=0
FRONTIER_RATE_OUT=0

# Chapter 20: the middle model tier, a 30B to 70B model (or a cheap hosted one) behind an OpenAI-compatible endpoint. Unset until you name a model.
AI_MID_PROVIDER=local-70b
# Chapter 21: with 64 GB+ of unified memory, `ollama create ledgerly-support-70b -f ops/ollama/Modelfile.ledgerly-support-70b` and then set LOCAL_70B_MODEL=ledgerly-support-70b. `php artisan ai:doctor --size --model=llama3.1:70b-instruct-q4_K_M` says whether it fits first.
LOCAL_70B_MODEL=
# LOCAL_70B_URL=   (defaults to AI_BASE_URL)
# ai:compare prices your own hardware by the GPU-hour. These are EXAMPLE VALUES, not quotes: 0 is a machine you already own; for a rented GPU copy the hourly price from your provider.
AI_GPU_USD_PER_HOUR=0
AI_70B_GPU_USD_PER_HOUR=0
# Keep each normalised request on its model_calls row so `ai:compare --from-calls` can replay it. It holds customer text: off by default, cleared after 7 days, refused for hosted providers.
AI_RECORD_REQUESTS=false

# Chapter 22: Ollama's server settings. Compose passes these to the ollama service; on a native Ollama set the same names in its own environment (systemd, launchd).
# ai:doctor reads them from here to check them against the app: slots = AI_CONCURRENCY, keep-alive not the 5m default.
OLLAMA_NUM_PARALLEL=2
OLLAMA_MAX_LOADED_MODELS=3
OLLAMA_KEEP_ALIVE=30m
OLLAMA_FLASH_ATTENTION=1
# The Compose ollama profile publishes this port on 127.0.0.1 only. Ollama has no authentication: never publish it wider.
OLLAMA_PORT=11434
# Send keep_alive with every request (30m, or -1 to pin the model). Empty leaves it to the server. Setting it makes the driver call /api/chat instead of /v1/.
AI_KEEP_ALIVE=

# Chapter 23: llama-server as a second local provider (`local-llama`), behind the same driver.
#   ./ops/llama/pull.sh                  fetch the pinned GGUF into ./models
#   docker compose --env-file .env -f ops/compose/base.yml -f ops/compose/llama.yml --profile llama up -d --build
# Which server the `local` role uses: ollama (default), llama, vllm (Chapter 24) or triton (Chapter 25). Ollama stays the development default; llama-server is for staging and the CPU tier; vLLM is GPU production; Triton is the fleet upgrade.
AI_LOCAL_PROVIDER=ollama
# The app runs on your machine, so localhost; from a container on the Compose network it is http://llama:8080/v1. Published on 127.0.0.1 only, on 8081 because Reverb has 8080 (Chapter 18).
LLAMA_URL=http://localhost:8081/v1
LLAMA_PORT=8081
# REQUIRED to start llama-server: Compose refuses an empty key. It is yours alone and never committed. Make one with `openssl rand -hex 24`.
LLAMA_API_KEY=
# cpu or cuda (cuda also needs -f ops/compose/llama.gpu.yml). LLAMA_TAG pins the llama.cpp release the image is built from.
LLAMA_VARIANT=cpu
LLAMA_TAG=b11829
# The flags of Figure 23-5/23-7. -c is the TOTAL context: 32768 over 4 slots is 8192 each, the Chapter 2 window. For the CPU profile (Figure 23-8):
# LLAMA_MODEL_FILE=gemma-3-4b-it-q6_k.gguf  LLAMA_CTX=16384  LLAMA_PARALLEL=2  LLAMA_NGL=0
LLAMA_MODEL_FILE=ledgerly-support-q4_k_m.gguf
LLAMA_CTX=32768
LLAMA_PARALLEL=4
LLAMA_NGL=99
LLAMA_FLASH_ATTN=on
LLAMA_CACHE_TYPE=q8_0
LLAMA_UBATCH=512

# Chapter 24: vLLM, the GPU production tier (`vllm` provider), behind the same driver. NVIDIA GPU only; Appendix L.7 rents one for an hour.
#   export HF_TOKEN=...   (only for a gated model; read from your shell, never from this file)
#   docker compose --env-file .env -f ops/compose/base.yml -f ops/compose/vllm.yml --profile vllm up -d
# The image and the model are PINNED, not `latest`: a new vLLM or a moved model branch would change answers and memory use under you. Change them on purpose, with ai:compare and ai:load before and after.
VLLM_IMAGE=vllm/vllm-openai:v0.32.0
VLLM_MODEL=RedHatAI/Meta-Llama-3.1-8B-Instruct-FP8
VLLM_REVISION=870a1177ed082c0ba5dbefd62573ab8f91803f6a
# The 70B mid tier for a rented 80 GB card (Topic 4); nothing reads it yet.
VLLM_MID_MODEL=hugging-quants/Meta-Llama-3.1-70B-Instruct-AWQ-INT4
VLLM_MID_REVISION=2123003760781134cfc31124aa6560a45b491fdf
# REQUIRED to start vLLM: Compose refuses an empty key. Make one with `openssl rand -hex 24`. Never committed.
VLLM_API_KEY=
# The app runs on your machine, so localhost on the published port (8001, because `php artisan serve` has 8000); from a container it is http://vllm:8000/v1. Published on 127.0.0.1 only.
VLLM_URL=http://localhost:8001/v1
VLLM_PORT=8001
VLLM_SERVED_MODEL=ledgerly-support
# The flags of Figure 24-5. --max-model-len is the Chapter 2 window; --max-num-seqs is a ceiling to match AI_CONCURRENCY; vLLM rejects a longer request instead of cutting it.
VLLM_MAX_MODEL_LEN=8192
VLLM_GPU_UTILIZATION=0.92
VLLM_MAX_NUM_SEQS=32
VLLM_TOOL_PARSER=llama3_json
VLLM_TIMEOUT=60
# A rented GPU's hourly price (example value, not a quote) so ai:compare can put a dollar figure on vLLM; 0 for a card you own.
AI_VLLM_GPU_USD_PER_HOUR=0

# Chapter 25: the operational layer, for every server in this section.
# Health: ai:doctor --health is reachable / loaded / warm / breaker; a completion within AI_WARM_SECONDS is "warm". `php artisan ai:warm` sends the system message once so the first customer does not pay for the cold start.
AI_WARM_SECONDS=3
# The circuit breaker: this many consecutive "the server is not there" errors open it for this many seconds; the work then goes to the fallback below or the cache-only path.
# The state lives in the cache store (AI_BREAKER_STORE, empty = the default) so every Horizon worker shares it.
AI_BREAKER_THRESHOLD=3
AI_BREAKER_OPEN_SECONDS=60
AI_BREAKER_STORE=
# Where support.reply goes while the local server is down. EMPTY by default: nothing is sent anywhere unless you name it. `frontier` is a hosted provider (FRONTIER_* above), so naming it
# means customer text leaves your network during an outage; leave it empty and the person gets "briefly unavailable" and cached how-to answers keep working.
AI_FALLBACK_LOCAL=

# Chapter 25: Triton, the fleet upgrade (`triton` provider). NVIDIA GPU only. ops/triton/export_onnx.py makes the ONNX models once; Triton has no authentication, so ops/compose/triton.yml puts an nginx proxy in front.
#   docker compose --env-file .env -f ops/compose/base.yml -f ops/compose/triton.yml --profile triton up -d
# PINNED images, not `latest`. The compiled profile (TensorRT-LLM, ops/triton/build-trtllm.sh) needs the -trtllm- image, TRITON_BACKEND=tensorrtllm and TRITON_MODELS=../triton/models-trtllm.
TRITON_IMAGE=nvcr.io/nvidia/tritonserver:26.09-vllm-python-py3
TRITON_PROXY_IMAGE=nginx:1.31.7-alpine
TRT_IMAGE_TAG=26.07-trtllm-python-py3
TRITON_BACKEND=vllm
TRITON_MODELS=../triton/models
TRITON_TOKENIZER=RedHatAI/Meta-Llama-3.1-8B-Instruct-FP8
# REQUIRED to start the proxy: Compose refuses an empty key. Make one with `openssl rand -hex 24`. Never committed.
TRITON_API_KEY=
# The proxy, published on 127.0.0.1 only (Triton itself publishes nothing); from a container it is http://triton:9000/v1.
TRITON_URL=http://localhost:9000/v1
TRITON_PORT=9000
TRITON_MODEL=chat
TRITON_TIMEOUT=60

# Chapter 25: monitoring. Prometheus publishes nothing; Grafana is published on 127.0.0.1 behind this login (REQUIRED, never committed).
#   docker compose --env-file .env -f ops/compose/base.yml -f ops/compose/vllm.yml -f ops/compose/monitoring.yml --profile vllm --profile monitoring up -d
PROMETHEUS_IMAGE=prom/prometheus:v3.15.1
GRAFANA_IMAGE=grafana/grafana:13.2.4
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=
GRAFANA_PORT=3000
# A bearer token for GET /ops/metrics (the circuit breaker, for the dashboard). Empty = the route is a 404. `openssl rand -hex 24`.
OPS_METRICS_TOKEN=


# Chapter 26: the Python environment in training/ (cd training && uv sync). HF_HOME moves the Hugging Face download cache to a bigger disk (empty = ~/.cache/huggingface);
# HF_TOKEN is needed only from Chapter 40, for gated models and the datasets that hold no customer data. Never commit a token.
HF_HOME=
HF_TOKEN=
