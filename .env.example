APP_NAME=Ledgerly
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# Postgres 16 + pgvector from compose.yaml. The tests use ledgerly_testing in the same container.
DB_CONNECTION=pgsql
DB_HOST=127.0.0.1
DB_PORT=5432
DB_DATABASE=ledgerly
DB_USERNAME=ledgerly
DB_PASSWORD=secret

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=reverb
FILESYSTEM_DISK=local
QUEUE_CONNECTION=redis

CACHE_STORE=database

# Redis from compose.yaml: the queue (Horizon) and the broadcast fan-out since Chapter 18. predis needs no PHP extension; set phpredis if you have it.
REDIS_CLIENT=predis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_FROM_ADDRESS="support@ledgerly.test"
MAIL_FROM_NAME="${APP_NAME}"

# The model server. Defaults point at Ollama on this machine (Chapter 0, Figure 0-6).
# From Chapter 22 the chat model is ledgerly-support: llama3.1:8b-instruct-q4_K_M with num_ctx 8192 baked in. Build it once:
#   ollama create ledgerly-support -f ops/ollama/Modelfile.ledgerly-support        (or `--profile ollama` in Compose does it for you)
# Until you have, AI_MODEL=llama3.1:8b works; `php artisan ai:doctor` says which of them truncates your prompts.
AI_BASE_URL=http://localhost:11434/v1
AI_API_KEY=ollama
AI_MODEL=ledgerly-support
# The app runs on your machine, so localhost reaches native Ollama (macOS, Windows, Linux service) and the Compose profile alike (it publishes 127.0.0.1 only).
# Only a container needs http://host.docker.internal:11434/v1 to reach a native Ollama on a Mac (ops/compose/macos.override.yml).
OLLAMA_URL=http://localhost:11434/v1

# Vision (Chapter 7): any vision-capable model. moondream is the lighter choice.
AI_VISION_MODEL=llama3.2-vision:11b

# Embeddings (Chapter 6). The vector column in help_chunks is 768 wide; change the model and you re-embed everything.
AI_EMBED_MODEL=nomic-embed-text
AI_EMBED_DIMENSIONS=768

# The date Ledgerly treats as "today" when it works out days overdue. The seed data is
# anchored to it so every reader sees the same numbers. Leave empty to use the real clock.
LEDGERLY_AS_OF=2026-04-20

# Token counting and the context budget (Chapter 2). ratio | tiktoken | server
AI_TOKEN_COUNTER=ratio
AI_CONTEXT_WINDOW=8192

# How structured output is requested (Chapter 10). schema = json_schema, json = json_object, ask = prompt only
AI_STRUCTURED_LEVEL=schema

# How records are written for the model (Chapter 12). toon | tsv | markdown | json
AI_ENCODING_DEFAULT=toon

# Chapter 14: answer repeated how-to questions from pgvector without calling the model; explicit cache markers for providers that need them (null = by provider)
AI_SEMANTIC_CACHE=true
AI_CACHE_BREAKPOINTS=

# Chapter 15: retrieval over the help center. hybrid | vector | keyword; LEDGERLY_HELP_VERSION pins the help_version (empty = help:ingest stamps a hash of the articles)
AI_RETRIEVAL_MODE=hybrid
LEDGERLY_HELP_VERSION=

# Chapter 16: reranking and PDF parsing in the Python sidecar (docker compose --profile sidecar up -d), query rewriting, parent-child chunks.
# With the sidecar stopped, retrieval falls back to the hybrid order and logs a warning.
AI_RERANKER=sidecar
SIDECAR_URL=http://localhost:8008
SIDECAR_PORT=8008
AI_QUERY_REWRITE=rewrite
AI_RETRIEVAL_STRATEGY=heading
AI_RETRIEVAL_CONTEXT_HEADERS=path
AI_RETRIEVAL_CONTEXT_MODEL=
LEDGERLY_DOCS_PATH=

# Chapter 17: classify the first question of a conversation (three votes) to choose tools and the retrieval area before the main call
AI_ROUTER=true

# Chapter 11: the user id that `php artisan mcp:start ledgerly` (stdio, no login) acts as. HTTP clients use a Sanctum token instead.
LEDGERLY_MCP_USER=

# Connection settings read by config/ai.php (Chapter 3 uses them for ai:timings; Chapter 8 for the client)
AI_PROVIDER=ollama
AI_CONNECT_TIMEOUT=2
AI_TIMEOUT=120

# Chapter 18: inference runs on the `ai` queue (Horizon) and streams to the browser through Reverb. Start them next to `php artisan serve`:
#   php artisan horizon        php artisan reverb:start
# AI_CONCURRENCY = how many model calls run at once. Match your model server (Ollama laptop: 1 to 2; Appendix G for GPUs).
AI_CONCURRENCY=2
REVERB_APP_ID=ledgerly-local
REVERB_APP_KEY=ledgerly-local-key
REVERB_APP_SECRET=ledgerly-local-secret-change-me
REVERB_HOST=localhost
REVERB_PORT=8080
REVERB_SCHEME=http
REVERB_SERVER_HOST=0.0.0.0
REVERB_SERVER_PORT=8080
REVERB_ALLOWED_ORIGINS=localhost,127.0.0.1

# Chapter 19: named providers (config/ai.php). `local` is the model above; `frontier` is a second, hosted, OpenAI-compatible endpoint for the hard cases.
# It is UNSET by default: with no FRONTIER_* variables nothing is ever sent to a hosted model, and `php artisan ai:providers` says so.
# Setting it means customer text can leave your network for the tickets the features map escalates (urgent bugs, investigations that reach no conclusion). Read your provider's data terms first.
AI_DEFAULT_PROVIDER=local
FRONTIER_DRIVER=openai-compatible
FRONTIER_URL=
FRONTIER_KEY=
FRONTIER_MODEL=
# $ per 1M tokens, from your provider's price page; 0 until you set them, so model_calls.cost_micros is honest about not knowing
FRONTIER_RATE_IN=0
FRONTIER_RATE_OUT=0

# Chapter 20: the middle model tier, a 30B to 70B model (or a cheap hosted one) behind an OpenAI-compatible endpoint. Unset until you name a model.
AI_MID_PROVIDER=local-70b
# Chapter 21: with 64 GB+ of unified memory, `ollama create ledgerly-support-70b -f ops/ollama/Modelfile.ledgerly-support-70b` and then set LOCAL_70B_MODEL=ledgerly-support-70b. `php artisan ai:doctor --size --model=llama3.1:70b-instruct-q4_K_M` says whether it fits first.
LOCAL_70B_MODEL=
# LOCAL_70B_URL=   (defaults to AI_BASE_URL)
# ai:compare prices your own hardware by the GPU-hour. These are EXAMPLE VALUES, not quotes: 0 is a machine you already own; for a rented GPU copy the hourly price from your provider.
AI_GPU_USD_PER_HOUR=0
AI_70B_GPU_USD_PER_HOUR=0
# Keep each normalised request on its model_calls row so `ai:compare --from-calls` can replay it. It holds customer text: off by default, cleared after 7 days, refused for hosted providers.
AI_RECORD_REQUESTS=false

# Chapter 22: Ollama's server settings. Compose passes these to the ollama service; on a native Ollama set the same names in its own environment (systemd, launchd).
# ai:doctor reads them from here to check them against the app: slots = AI_CONCURRENCY, keep-alive not the 5m default.
OLLAMA_NUM_PARALLEL=2
OLLAMA_MAX_LOADED_MODELS=3
OLLAMA_KEEP_ALIVE=30m
OLLAMA_FLASH_ATTENTION=1
# The Compose ollama profile publishes this port on 127.0.0.1 only. Ollama has no authentication: never publish it wider.
OLLAMA_PORT=11434
# Send keep_alive with every request (30m, or -1 to pin the model). Empty leaves it to the server. Setting it makes the driver call /api/chat instead of /v1/.
AI_KEEP_ALIVE=

# Chapter 23: llama-server as a second local provider (`local-llama`), behind the same driver.
#   ./ops/llama/pull.sh                  fetch the pinned GGUF into ./models
#   docker compose --env-file .env -f ops/compose/base.yml -f ops/compose/llama.yml --profile llama up -d --build
# Which server the `local` role uses: ollama (default), llama, vllm (Chapter 24) or triton (Chapter 25). Ollama stays the development default; llama-server is for staging and the CPU tier; vLLM is GPU production; Triton is the fleet upgrade.
AI_LOCAL_PROVIDER=ollama
# The app runs on your machine, so localhost; from a container on the Compose network it is http://llama:8080/v1. Published on 127.0.0.1 only, on 8081 because Reverb has 8080 (Chapter 18).
LLAMA_URL=http://localhost:8081/v1
LLAMA_PORT=8081
# REQUIRED to start llama-server: Compose refuses an empty key. It is yours alone and never committed. Make one with `openssl rand -hex 24`.
LLAMA_API_KEY=
# cpu or cuda (cuda also needs -f ops/compose/llama.gpu.yml). LLAMA_TAG pins the llama.cpp release the image is built from.
LLAMA_VARIANT=cpu
LLAMA_TAG=b11829
# The flags of Figure 23-5/23-7. -c is the TOTAL context: 32768 over 4 slots is 8192 each, the Chapter 2 window. For the CPU profile (Figure 23-8):
# LLAMA_MODEL_FILE=gemma-3-4b-it-q6_k.gguf  LLAMA_CTX=16384  LLAMA_PARALLEL=2  LLAMA_NGL=0
LLAMA_MODEL_FILE=ledgerly-support-q4_k_m.gguf
LLAMA_CTX=32768
LLAMA_PARALLEL=4
LLAMA_NGL=99
LLAMA_FLASH_ATTN=on
LLAMA_CACHE_TYPE=q8_0
LLAMA_UBATCH=512

# Chapter 24: vLLM, the GPU production tier (`vllm` provider), behind the same driver. NVIDIA GPU only; Appendix L.7 rents one for an hour.
#   export HF_TOKEN=...   (only for a gated model; read from your shell, never from this file)
#   docker compose --env-file .env -f ops/compose/base.yml -f ops/compose/vllm.yml --profile vllm up -d
# The image and the model are PINNED, not `latest`: a new vLLM or a moved model branch would change answers and memory use under you. Change them on purpose, with ai:compare and ai:load before and after.
VLLM_IMAGE=vllm/vllm-openai:v0.32.0
VLLM_MODEL=RedHatAI/Meta-Llama-3.1-8B-Instruct-FP8
VLLM_REVISION=870a1177ed082c0ba5dbefd62573ab8f91803f6a
# The 70B mid tier for a rented 80 GB card (Topic 4); nothing reads it yet.
VLLM_MID_MODEL=hugging-quants/Meta-Llama-3.1-70B-Instruct-AWQ-INT4
VLLM_MID_REVISION=2123003760781134cfc31124aa6560a45b491fdf
# REQUIRED to start vLLM: Compose refuses an empty key. Make one with `openssl rand -hex 24`. Never committed.
VLLM_API_KEY=
# The app runs on your machine, so localhost on the published port (8001, because `php artisan serve` has 8000); from a container it is http://vllm:8000/v1. Published on 127.0.0.1 only.
VLLM_URL=http://localhost:8001/v1
VLLM_PORT=8001
VLLM_SERVED_MODEL=ledgerly-support
# The flags of Figure 24-5. --max-model-len is the Chapter 2 window; --max-num-seqs is a ceiling to match AI_CONCURRENCY; vLLM rejects a longer request instead of cutting it.
VLLM_MAX_MODEL_LEN=8192
VLLM_GPU_UTILIZATION=0.92
VLLM_MAX_NUM_SEQS=32
VLLM_TOOL_PARSER=llama3_json
VLLM_TIMEOUT=60
# A rented GPU's hourly price (example value, not a quote) so ai:compare can put a dollar figure on vLLM; 0 for a card you own.
AI_VLLM_GPU_USD_PER_HOUR=0

# Chapter 25: the operational layer, for every server in this section.
# Health: ai:doctor --health is reachable / loaded / warm / breaker; a completion within AI_WARM_SECONDS is "warm". `php artisan ai:warm` sends the system message once so the first customer does not pay for the cold start.
AI_WARM_SECONDS=3
# The circuit breaker: this many consecutive "the server is not there" errors open it for this many seconds; the work then goes to the fallback below or the cache-only path.
# The state lives in the cache store (AI_BREAKER_STORE, empty = the default) so every Horizon worker shares it.
AI_BREAKER_THRESHOLD=3
AI_BREAKER_OPEN_SECONDS=60
AI_BREAKER_STORE=
# Where support.reply goes while the local server is down. EMPTY by default: nothing is sent anywhere unless you name it. `frontier` is a hosted provider (FRONTIER_* above), so naming it
# means customer text leaves your network during an outage; leave it empty and the person gets "briefly unavailable" and cached how-to answers keep working.
AI_FALLBACK_LOCAL=

# Chapter 25: Triton, the fleet upgrade (`triton` provider). NVIDIA GPU only. ops/triton/export_onnx.py makes the ONNX models once; Triton has no authentication, so ops/compose/triton.yml puts an nginx proxy in front.
#   docker compose --env-file .env -f ops/compose/base.yml -f ops/compose/triton.yml --profile triton up -d
# PINNED images, not `latest`. The compiled profile (TensorRT-LLM, ops/triton/build-trtllm.sh) needs the -trtllm- image, TRITON_BACKEND=tensorrtllm and TRITON_MODELS=../triton/models-trtllm.
TRITON_IMAGE=nvcr.io/nvidia/tritonserver:26.09-vllm-python-py3
TRITON_PROXY_IMAGE=nginx:1.31.7-alpine
TRT_IMAGE_TAG=26.07-trtllm-python-py3
TRITON_BACKEND=vllm
TRITON_MODELS=../triton/models
TRITON_TOKENIZER=RedHatAI/Meta-Llama-3.1-8B-Instruct-FP8
# REQUIRED to start the proxy: Compose refuses an empty key. Make one with `openssl rand -hex 24`. Never committed.
TRITON_API_KEY=
# The proxy, published on 127.0.0.1 only (Triton itself publishes nothing); from a container it is http://triton:9000/v1.
TRITON_URL=http://localhost:9000/v1
TRITON_PORT=9000
TRITON_MODEL=chat
TRITON_TIMEOUT=60

# Chapter 25: monitoring. Prometheus publishes nothing; Grafana is published on 127.0.0.1 behind this login (REQUIRED, never committed).
#   docker compose --env-file .env -f ops/compose/base.yml -f ops/compose/vllm.yml -f ops/compose/monitoring.yml --profile vllm --profile monitoring up -d
PROMETHEUS_IMAGE=prom/prometheus:v3.15.1
GRAFANA_IMAGE=grafana/grafana:13.2.4
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=
GRAFANA_PORT=3000
# A bearer token for GET /ops/metrics (the circuit breaker, for the dashboard). Empty = the route is a 404. `openssl rand -hex 24`.
OPS_METRICS_TOKEN=


# Chapter 26: the Python environment in training/ (cd training && uv sync). HF_HOME moves the Hugging Face download cache to a bigger disk (empty = ~/.cache/huggingface);
# HF_TOKEN is needed only from Chapter 40, for gated models and the datasets that hold no customer data. Never commit a token.
HF_HOME=
HF_TOKEN=

# Chapter 27: a Python worker beside PHP. py-worker (profile `python`) embeds on Redis stream tasks, py:listen applies its results; only Redis is shared, Python never gets a database credential.
#   docker compose --env-file .env -f ops/compose/base.yml --profile python up -d --build py-worker py-listen
# NOMIC_REVISION pins the model repo, NOMIC_CODE_REVISION the second repo (nomic-ai/nomic-bert-2048) whose Python code the worker runs (trust_remote_code); change either only after reading the diff. TRAINING_TAG names the worker image.
# TASK_TIMEOUT_MS: how long a worker's unacknowledged entry may sit before another worker reclaims it. PY_TASK_TIMEOUT: seconds before py:listen marks a queued task failed.
TRAINING_TAG=vol2
NOMIC_REVISION=e9b6763023c676ca8431644204f50c2b100d9aab
NOMIC_CODE_REVISION=7710840340a098cfb869c4f65e87cf2b1b70caca
TASK_TIMEOUT_MS=120000
PY_TASK_TIMEOUT=600

# Chapter 28: the MLflow tracker (profile `mlflow`): docker compose --env-file .env -f ops/compose/base.yml -f ops/compose/mlflow.yml --profile mlflow up -d mlflow
# It has no login, so it is published on 127.0.0.1 only. Training scripts and the evaluation reports read MLFLOW_TRACKING_URI.
MLFLOW_IMAGE=ghcr.io/mlflow/mlflow:v3.17.2
MLFLOW_PORT=5050
MLFLOW_TRACKING_URI=http://localhost:5050

# Chapter 29: POST /eval/answer runs the whole assistant pipeline for promptfoo and eval:gates. It exists only when AI_EVAL_ENABLED=true (CI and your machine, never production), wants EVAL_TOKEN as a bearer token,
# and answers only as the seeded fixture customers. EVAL_JUDGE_PROVIDER is the promptfoo provider id of the nightly rubric judge (a different family from the local model); EVAL_NOTIFY_WEBHOOK receives the nightly summary.
AI_EVAL_ENABLED=false
EVAL_TOKEN=
EVAL_JUDGE_PROVIDER=openai:chat:{{env.FRONTIER_MODEL}}
EVAL_NOTIFY_WEBHOOK=

# Chapter 30: pinned models. AI_LOCAL_DIGEST / LOCAL_70B_DIGEST: the manifest digest `ollama show` reports (ai:models:audit compares it with the server's). FRONTIER_DEPRECATES_ON: the retirement date, written down the day the provider's
# notice arrives (YYYY-MM-DD); FRONTIER_CANDIDATE: the replacement you are evaluating. Always a fixed, versioned FRONTIER_MODEL, never a "latest" alias.
AI_LOCAL_DIGEST=
LOCAL_70B_DIGEST=
LOCAL_70B_DEPRECATES_ON=
LOCAL_70B_CANDIDATE=
FRONTIER_DEPRECATES_ON=
FRONTIER_CANDIDATE=
# Chapter 30: the judge the Python worker uses for the sampled RAGAS and DeepEval scores (cd training && uv run python -m workers.eval_worker). Any OpenAI-compatible endpoint; point it at a different model family
# than the one under test (the `frontier` role, or a mid-size local model). The defaults score with the same local Ollama, which is fine for wiring and wrong for judging: a model grades its own style generously.
JUDGE_BASE_URL=http://localhost:11434/v1
JUDGE_MODEL=llama3.1:8b
JUDGE_API_KEY=ollama
JUDGE_EMBED_MODEL=nomic-embed-text

# Chapter 31: tracing. Off by default (the SDK is not even started): set OTEL_PHP_AUTOLOAD_ENABLED=true after you start the observability profile
#   docker compose --env-file .env -f ops/compose/base.yml -f ops/compose/observability.yml --profile observability up -d
# The app on the host exports to the collector on 127.0.0.1:4318; the Python services and the sidecar get their own OTEL_* from ops/compose/observability.yml. Sampling keeps every trace in development: use 0.1 in production.
# The collector deletes attributes that look like prompt or completion content (ops/compose/otel-collector.yaml), whatever the code sets. OTEL_COLLECTOR_IMAGE and JAEGER_IMAGE are pinned by tag; JAEGER_URL is where ai:sample --trace points its link.
OTEL_PHP_AUTOLOAD_ENABLED=false
OTEL_SERVICE_NAME=ledgerly-app
OTEL_TRACES_EXPORTER=otlp
OTEL_METRICS_EXPORTER=none
OTEL_LOGS_EXPORTER=none
OTEL_EXPORTER_OTLP_PROTOCOL=http/protobuf
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318
OTEL_TRACES_SAMPLER=parentbased_traceidratio
OTEL_TRACES_SAMPLER_ARG=1.0
OTEL_COLLECTOR_IMAGE=otel/opentelemetry-collector-contrib:0.163.2
JAEGER_IMAGE=jaegertracing/all-in-one:1.76.0
OTEL_HTTP_PORT=4318
JAEGER_PORT=16686
JAEGER_MAX_TRACES=5000
JAEGER_URL=http://localhost:16686
# Laravel Pulse (Chapter 31, Topic 7) at /pulse for staff users; it stores its aggregates in your database.
PULSE_ENABLED=true

# Chapter 32: injection defences. The canary is planted in every system message and blocks an answer that repeats it: use your own phrase in production. AI_LINK_HOSTS is the allow-list for links and images in answers (the app's own APP_URL host is always allowed).
AI_PROMPT_CANARY=amber-heron-4471-lattice
AI_LINK_HOSTS=ledgerly.test,example.com

# Chapter 33: the tool gate. Every conversation may make this many tool calls in all (the ninth is refused); each tool also has its own limit in code.
AI_TOOL_CONVERSATION_BUDGET=8
# One restricted key per external tool, never one key for the app. Empty means the tool gets none. retry_payment talks to a payment processor (fictional in this repository).
PAYMENTS_KEY_RETRY_PAYMENT=
# Short-lived credentials for document tools (Volume 3): the role the gate assumes for fifteen minutes with a policy narrowed to one tenant's prefix.
DOCUMENTS_ROLE_ARN=
DOCUMENTS_BUCKET=
# The sandbox for code a model wrote (docker build -t ledgerly-sandbox:vol2 ops/sandbox). Off everywhere but a dedicated worker host. SANDBOX_RUNTIME=runsc adds gVisor where it is installed.
SANDBOX_ENABLED=false
SANDBOX_IMAGE=ledgerly-sandbox:vol2
SANDBOX_RUNTIME=
SANDBOX_MEMORY=256m
SANDBOX_CPUS=0.5
SANDBOX_PIDS=64
SANDBOX_TIMEOUT=10

# Chapter 34: privacy. PRESIDIO_URL is the privacy profile's name and address detector (docker compose ... -f ops/compose/privacy.yml --profile privacy up -d --build presidio, then http://127.0.0.1:5002). Empty means names and addresses cannot be screened,
# so a call to a provider that redacts (frontier, or local-70b with LOCAL_70B_REDACT=true) is rerouted to the local role instead of going out half-screened. The pattern detectors (card, SSN, email, phone, IBAN) run in PHP and never need it.
PRESIDIO_URL=
PRESIDIO_IMAGE=ledgerly-presidio:vol2
PRESIDIO_PORT=5002
PRESIDIO_SCORE_THRESHOLD=0.5
# libphonenumber's region for numbers written without a country code; addresses of your own that are not customers' (comma-separated domains).
AI_PRIVACY_PHONE_REGION=US
AI_PRIVACY_OWN_DOMAINS=ledgerly.test
# How long a conversation's vault of placeholders lives (it is rewritten with every new value), and when the copies user:forget cannot delete expire on their own (reported on the receipt).
AI_VAULT_TTL_DAYS=7
AI_TRACE_RETENTION_DAYS=7
BACKUP_RETENTION_DAYS=35
# The five questions about the hosted provider, answered once, with the date you checked and the page you read (Figure 34-2). support.reply may only escalate to a provider whose DPA is signed.
FRONTIER_RETENTION_DAYS=
FRONTIER_ZDR=false
FRONTIER_REGION=
FRONTIER_DPA_SIGNED=false
FRONTIER_TERMS_CHECKED_ON=
FRONTIER_TERMS_URL=
LOCAL_70B_REDACT=false

# Chapter 35: cost. config/ai-pricing.php prices every call (illustrative round numbers until you copy your provider's rates above: FRONTIER_RATE_IN and FRONTIER_RATE_OUT, $ per 1M tokens; a hosted model with rates of 0 is unpriced and `php artisan ai:cost-audit` refuses it).
# Cache reads and writes default to the input rate until you set them. The pricing page goes in FRONTIER_PRICING_URL; change `version` in config/ai-pricing.php whenever you change a price.
# FRONTIER_RATE_CACHE_READ=
# FRONTIER_RATE_CACHE_WRITE=
FRONTIER_PRICING_URL=
# Per-provider limits on the answer jobs, set BELOW the provider's own limits (requests and tokens per minute).
FRONTIER_RPM=300
FRONTIER_TPM=200000
# A ceiling on retrieved sources per prompt, and the input one call may carry before ai:cost-audit flags it. help:ingest refuses chunks that moved in size. A question older than this many minutes is answered from a template.
AI_CONTEXT_SOURCES_MAX_TOKENS=3000
AI_CONTEXT_CALL_BUDGET=6000
AI_INGEST_CHUNK_GATE=true
AI_REPLY_FRESHNESS_MINUTES=30
# The public "Ask Ledgerly" page (/widget): local role only, short answers, a proof-of-work challenge, a budget per session and a daily one for everyone.
AI_WIDGET_ENABLED=true
AI_WIDGET_MAX_TOKENS=150
AI_WIDGET_SESSION_QUESTIONS=8
AI_WIDGET_DAILY_TOKENS=1500000
AI_WIDGET_IP_PER_MINUTE=12
AI_WIDGET_POW_DIFFICULTY=4

# Chapter 36: the ledger and the budgets. Every call becomes one row in ai_ledger (integer micro-dollars, priced when written) through a Redis stream and the `ledger` Horizon queue; counters in Redis enforce budgets before each call.
# AI_BUDGETS_STORE=array keeps the counters in memory (one process; a machine with no Redis). With Redis unreachable a call goes through unguarded and the failure is logged. The amounts per plan, feature and hour are in config/ai.php (`budgets`).
AI_BUDGETS_ENABLED=true
AI_BUDGETS_STORE=redis
AI_BUDGETS_REDIS_CONNECTION=default
AI_LEDGER_ENABLED=true
# An amortized rate ($ per 1M tokens) charged to your own hardware so local use shows in a team's spend; 0 = tokens only.
AI_HARDWARE_USD_PER_M=0
# Who is paged when the kill switch fires, where the team channel is (a Slack-compatible incoming webhook), each team's address for the 80% notices and the weekly showback, and a usage export for `ai:reconcile`.
AI_ONCALL_EMAIL=
AI_TEAM_CHANNEL_WEBHOOK=
AI_PROVIDER_USAGE_FILE=
TEAM_SUPPORT_EMAIL=
TEAM_BILLING_EMAIL=
TEAM_GROWTH_EMAIL=
TEAM_PLATFORM_EMAIL=
TEAM_FINANCE_EMAIL=

# Chapter 37: a tiered router that escalates on failed checks. config/ai-routes.php is written by `php artisan eval:route-table` from golden-set pass rates; AI_CASCADE=false answers on the feature's own role, as before.
# What a person's handling of an escalated conversation costs, for `ai:cascade-report`'s total cost per conversation (illustrative).
AI_CASCADE=true
AI_HUMAN_COST_PER_ESCALATION=4.00
# The semantic cache's similarity threshold, chosen from labeled pairs with `php artisan ai:cache-tune`. Smaller requests: duplicate passages are dropped; trimming long passages to the paragraphs that match stays off until the golden set says it is safe.
AI_SEMANTIC_CACHE_THRESHOLD=0.92
AI_PRUNE_DEDUPE=true
AI_PRUNE_TRIM=false
# Batch work (the nightly judge, synthetic cases): the batch price as a share off the interactive one. Illustrative: copy your provider's.
AI_BATCH_DISCOUNT=0.5

# Chapter 40: the key for the one-way hash of each training example's source conversation, tenant and user. Generate your own (`php artisan tinker --execute='echo bin2hex(random_bytes(32));'`); dataset:export refuses to run without it. Keep it with the other secrets, never in a dataset.
AI_TRAINING_HASH_KEY=
# Where datasets built from customer conversations are stored, per region (an S3 bucket with encryption and versioning on; empty = a local folder under storage/app/training/). A write-capable HF_TOKEN publishes only the datasets with no customer data to the Hub.
TRAINING_EU_BUCKET=
TRAINING_EU_REGION=eu-west-1
TRAINING_US_BUCKET=
TRAINING_US_REGION=us-east-1
# The tokenizer repository whose chat template `ai:template-check` renders training prompts with: the base the adapter was trained on. The Llama repository is gated (needs HF_TOKEN and the licence accepted).
TEMPLATE_CHECK_TOKENIZER=meta-llama/Llama-3.1-8B-Instruct

# Chapter 41: a hosted fine-tune, as a role beside its base (`frontier-billing-ft` in config/ai.php). `php artisan ai:ft:register` writes the first five; fill the three rates from your provider's pricing page (Appendix F.8): a fine-tune with no price is unpriced, and `ai:cost-audit` fails on it.
# FRONTIER_FT_DRIVER: `openai` for an OpenAI-shaped fine-tuning API, `fake` for the offline Build (no account, no money; FT_FAKE_SECONDS is how long a fake job takes). AI_FAKE_FT_CHAT=true (with AI_EVAL_ENABLED) serves the fake model's chat replies from this app.
FRONTIER_FT_DRIVER=openai
FT_FAKE_SECONDS=20
AI_FAKE_FT_CHAT=false
FT_MAX_TOKENS_PER_ROW=16384
BILLING_FT_MODEL=
BILLING_FT_BASE=
BILLING_FT_JOB=
BILLING_FT_DATASET=billing-v1
BILLING_FT_DATASET_HASH=
BILLING_FT_RATE_IN=
BILLING_FT_RATE_OUT=
BILLING_FT_TRAIN_RATE=
# Which provider judges the comparison's answers (a different family from the model under test).
COMPARE_JUDGE_PROVIDER=local

# Chapter 42: the billing fine-tune trained and served on your own hardware (role `local-billing-ft`). BILLING_FT_URL is the server that has `ledgerly-billing-ft` (the regional Ollama box, e.g. http://localhost:11434/v1); the role is not set up until it is named. Chapter 44 resolves the model name from the registry.
BILLING_FT_URL=
BILLING_FT_REGION=local
BILLING_FT_LOCAL_MODEL=ledgerly-billing-ft
BILLING_FT_LOCAL_KEY=ollama
BILLING_FT_TIMEOUT=120
BILLING_FT_LOCAL_DIGEST=
BILLING_FT_LICENSE_REVIEWED=
BILLING_FT_LOCAL_BASE=meta-llama/Llama-3.1-8B-Instruct
BILLING_FT_LOCAL_DATASET=billing-v1
BILLING_FT_LOCAL_DATASET_HASH=
BILLING_FT_LOCAL_RUN=
# Where `eval:compare --with=tripwire:all` finds the fused 16-bit fine-tune (written by training/scripts/export_to_ollama.py), relative to training/.
BILLING_FT_FUSED_PATH=models/ledgerly-billing-ft/fused

# Chapter 44: the model registry, the servers serve:fine-tune puts a version on, and what an artifact must prove before it is loaded.
# The registry rewrites storage/app/registry/aliases.json on every promotion and rollback; config/ai.php reads billing@production from it.
REGISTRY_SHADOW_PERCENT=10
REGISTRY_WARM_DAYS=7
REGISTRY_GUARDRAIL_MIN_ANSWERS=20
OLLAMA_NATIVE_URL=http://localhost:11434
OLLAMA_NATIVE_HOST=
OLLAMA_BINARY=ollama
REGISTRY_OLLAMA_URL=
REGISTRY_OLLAMA_HOST=
REGISTRY_VLLM_URL=
REGISTRY_VLLM_BASE=meta-llama/Llama-3.1-8B-Instruct
REGISTRY_VLLM_ADAPTERS_PATH=/models/adapters
REGISTRY_VLLM_MAX_LORA_RANK=16
# The exact base revision vLLM was started with (vllm serve --revision "$BASE_REVISION"): an adapter is loaded only beside the revision it was trained on.
BASE_REVISION=
# Approved bases, mirrored where production can read them, and where retired versions' artifacts are archived.
REGISTRY_MIRROR=
REGISTRY_ARCHIVE=
REGISTRY_VERIFY_BASE=true
# Signing: the pipeline holds the secret key file (registry:keygen makes the pair); every server holds only the public key. REGISTRY_SIGNER=cosign uses Sigstore's cosign with COSIGN_*.
REGISTRY_SIGNER=ed25519
REGISTRY_REQUIRE_SIGNATURES=true
REGISTRY_SIGNING_PIPELINE=ledgerly-training
REGISTRY_SIGNING_PUBLIC_KEY=
REGISTRY_SIGNING_KEY_FILE=
COSIGN_BINARY=cosign
COSIGN_KEY=
COSIGN_PASSWORD=
COSIGN_PUBLIC_KEY=
AI_ALERTS_CHANNEL=#ai-quality
# The larger open-weight model in the residency region: the residency tenants' escalation tier and (Chapter 46) the distillation teacher. Unset until MID_IN_REGION_URL names a server.
MID_IN_REGION_URL=
MID_IN_REGION_MODEL=
MID_IN_REGION_KEY=ollama
MID_IN_REGION_REGION=
MID_IN_REGION_LICENSE=
MID_IN_REGION_LICENSE_REVIEWED=
MID_IN_REGION_LICENSE_REVIEWED_BY=
MID_IN_REGION_DIGEST=
MID_IN_REGION_TIMEOUT=300

# Chapter 46: the distilled student (a second adapter on the vLLM server of Chapter 44), the teacher dataset:distill uses, and where the tuned embedding models are served from.
# Unset until SUPPORT_FT_URL names the server. MID_IN_REGION_LICENSE, _LICENSE_REVIEWED and _LICENSE_REVIEWED_BY are the teacher's recorded distillation basis: dataset:distill refuses a teacher without all three.
SUPPORT_FT_URL=
SUPPORT_FT_MODEL=
SUPPORT_FT_KEY=
SUPPORT_FT_REGION=
SUPPORT_FT_BASE=meta-llama/Llama-3.1-8B-Instruct
SUPPORT_FT_DATASET=support-distill-v1
SUPPORT_FT_LICENSE_REVIEWED=
SUPPORT_FT_TIMEOUT=120
AI_DISTILL_TEACHER=mid-in-region
EMBED_MODELS_DIR=runs/embeddings
