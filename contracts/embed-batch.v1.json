{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ledgerly.test/contracts/embed-batch.v1.json",
  "title": "EmbedBatch",
  "type": "object",
  "required": ["schema", "task_id", "request_id", "model", "items"],
  "additionalProperties": false,
  "properties": {
    "schema":     { "const": "embed-batch.v1" },
    "task_id":    { "type": "string", "format": "uuid" },
    "request_id": { "type": ["string", "null"] },
    "model":      { "type": "string", "minLength": 1 },
    "items": {
      "type": "array", "minItems": 1, "maxItems": 256,
      "items": {
        "type": "object", "required": ["id", "text"], "additionalProperties": false,
        "properties": { "id": { "type": "integer" }, "text": { "type": "string", "minLength": 1 } }
      }
    }
  }
}
