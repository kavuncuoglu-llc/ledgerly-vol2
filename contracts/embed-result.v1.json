{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ledgerly.test/contracts/embed-result.v1.json",
  "title": "EmbedResult",
  "type": "object",
  "required": ["schema", "task_id", "request_id", "model", "items", "elapsed_ms"],
  "additionalProperties": false,
  "properties": {
    "schema":     { "const": "embed-result.v1" },
    "task_id":    { "type": "string", "format": "uuid" },
    "request_id": { "type": ["string", "null"] },
    "model":      { "type": "string", "minLength": 1 },
    "items": {
      "type": "array", "minItems": 1, "maxItems": 256,
      "items": {
        "type": "object", "required": ["id", "vector"], "additionalProperties": false,
        "properties": {
          "id":     { "type": "integer" },
          "vector": { "type": "array", "minItems": 1, "items": { "type": "number" } }
        }
      }
    },
    "elapsed_ms": { "type": "integer", "minimum": 0 }
  }
}
