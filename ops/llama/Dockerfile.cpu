# ops/llama/Dockerfile.cpu: llama-server for a CPU-only machine (Chapter 23, Topic 2). Pinned release; build it on the machine that will run it so -DGGML_NATIVE=ON matches its CPU.
FROM ubuntu:24.04 AS build
ARG LLAMA_TAG=b11829
ARG GGML_NATIVE=ON
RUN apt-get update && apt-get install -y --no-install-recommends git cmake build-essential ca-certificates && rm -rf /var/lib/apt/lists/*
RUN git clone --depth 1 --branch ${LLAMA_TAG} https://github.com/ggml-org/llama.cpp /src \
 && cmake -S /src -B /src/build -DGGML_NATIVE=${GGML_NATIVE} -DBUILD_SHARED_LIBS=OFF -DLLAMA_CURL=OFF \
 && cmake --build /src/build --config Release -j --target llama-server

FROM ubuntu:24.04
RUN apt-get update && apt-get install -y --no-install-recommends libgomp1 curl ca-certificates && rm -rf /var/lib/apt/lists/*
COPY --from=build /src/build/bin/llama-server /usr/local/bin/
EXPOSE 8080
ENTRYPOINT ["llama-server", "--host", "0.0.0.0", "--port", "8080"]
