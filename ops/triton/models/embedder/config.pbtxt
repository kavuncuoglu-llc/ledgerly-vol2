# Chapter 25, Topic 2: the embedding model (nomic-embed-text, 768 dimensions) as an ONNX model with the pooling baked in by ops/triton/export_onnx.py, so the output is one vector per text.
name: "embedder"
backend: "onnxruntime"
max_batch_size: 64
input  [ { name: "input_ids",      data_type: TYPE_INT64, dims: [ -1 ] },
         { name: "attention_mask", data_type: TYPE_INT64, dims: [ -1 ] } ]
output [ { name: "embedding",      data_type: TYPE_FP32,  dims: [ 768 ] } ]
dynamic_batching { max_queue_delay_microseconds: 2000 }
instance_group [ { count: 1, kind: KIND_GPU, gpus: [ 0 ] } ]
version_policy { latest { num_versions: 1 } }
model_warmup [
  {
    name: "one text"
    batch_size: 1
    inputs { key: "input_ids"      value: { data_type: TYPE_INT64 dims: [ 16 ] zero_data: true } }
    inputs { key: "attention_mask" value: { data_type: TYPE_INT64 dims: [ 16 ] zero_data: true } }
  }
]
